# Zatroz environment example (safe to commit)
# Copy to .env.local for local development. Do not put real secrets here.
# Do not set NODE_ENV in this file.
#
# Public pages must build with blank integration values.
# Never use NEXT_PUBLIC_ for server secrets.

# Public-safe site origin (http or https). Localhost is fine during setup.
# Before any public release, Step 67 must set and verify the real production URL.
SITE_URL=http://localhost:3000

# Application environment marker (development | test | preview | production).
APP_ENV=development

# --- MongoDB Atlas (application database; Step 44+) ---
# Server only. See docs/setup/mongodb-atlas.md. Never commit real URIs.
MONGODB_URI=
MONGODB_DB_NAME=zatroz_dev

# Maintenance credential for schema/index tooling (Step 45+) — not for web runtime.
MONGODB_MIGRATION_URI=

# Explicit disposable test database (integration tests only).
MONGODB_TEST_URI=
MONGODB_TEST_DB_NAME=zatroz_test

# Exact approved site origin for later request policy (non-secret when set).
APP_ORIGIN=

# Enquiry submission activation (server only; never sole readiness proof).
ENQUIRIES_ENABLED=

# Abuse-control HMAC secret (server only; Step 46+).
ABUSE_HASH_SECRET=
# Optional previous/next version during rotation (server only).
ABUSE_HASH_SECRET_V2=

# Idempotency fingerprint HMAC secret (server only; later steps).
ENQUIRY_IDEMPOTENCY_SECRET=
ENQUIRY_IDEMPOTENCY_SECRET_V2=

# --- Legacy / later notification providers (not MongoDB) ---
# Older Supabase placeholders are unused — MongoDB Atlas is the application DB.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Required later: transactional email (Resend).
RESEND_API_KEY=

# Required later: verified sender address for enquiry notifications.
ENQUIRY_FROM_EMAIL=

# Required later: team inbox that receives enquiry notifications.
ENQUIRY_NOTIFICATION_EMAIL=

# Required later: Cloudflare Turnstile public site key (browser-safe).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required later: Turnstile secret for server verification (never NEXT_PUBLIC_).
TURNSTILE_SECRET_KEY=

# Required for protected job endpoints (content refresh A11+; notification retry later).
# Generate with: openssl rand -base64 32 (≥16 chars). Never invent values in chat.
CRON_SECRET=

# --- Staff admin auth (Better Auth + MongoDB; A02+) ---
# Server only. Generate with: openssl rand -base64 32
# Never commit real values. Marketing builds may leave these blank.
BETTER_AUTH_SECRET=
# Optional absolute origin override (defaults to SITE_URL / localhost).
BETTER_AUTH_URL=
# Optional TOTP issuer label shown in authenticator apps.
BETTER_AUTH_APP_NAME=Zatroz Admin

# One-time owner bootstrap only (scripts/admin-bootstrap-owner.ts).
# Clear after first successful MFA enrollment. Never invent passwords in chat.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# --- Admin media (Cloudinary; A04+) ---
# Server only. Never commit real values. Marketing builds may leave blank.
# Signed upload + authenticated (private) delivery — folder names are not ACLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder prefix hint (default zatroz). App env is appended automatically.
CLOUDINARY_FOLDER_PREFIX=zatroz
