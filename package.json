{
  "name": "zatroz-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:public-projects": "tsx scripts/test-public-projects.ts",
    "test:public-case-studies": "tsx scripts/test-public-case-studies.ts",
    "test:contact-service-query": "tsx scripts/test-contact-service-query.ts",
    "test:enquiry-input": "tsx scripts/test-enquiry-input.ts",
    "test:enquiry-transport": "tsx scripts/test-enquiry-transport.ts",
    "test:mongodb-foundation": "tsx scripts/test-mongodb-foundation.ts",
    "test:mongodb-models": "tsx scripts/test-mongodb-models.ts",
    "test:request-safeguards": "tsx scripts/test-request-safeguards.ts",
    "test:admin-auth": "tsx scripts/test-admin-auth.ts",
    "test:admin-shell": "tsx scripts/test-admin-shell.ts",
    "test:admin-media": "tsx scripts/test-admin-media.ts",
    "test:admin-projects": "tsx scripts/test-admin-projects.ts",
    "test:admin-story": "tsx scripts/test-admin-story.ts",
    "test:admin-preview": "tsx scripts/test-admin-preview.ts",
    "test:admin-publish": "tsx scripts/test-admin-publish.ts",
    "test:admin-featured": "tsx scripts/test-admin-featured.ts",
    "test:admin-repo-migration": "tsx scripts/test-admin-repo-migration.ts",
    "migrate:repo-portfolio": "tsx scripts/migrate-repo-portfolio.ts",
    "admin:bootstrap-owner": "tsx scripts/admin-bootstrap-owner.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:plan": "tsx scripts/db-plan.ts",
    "db:apply": "tsx scripts/db-apply.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate:content && npm run test:public-projects && npm run test:public-case-studies && npm run test:contact-service-query && npm run test:enquiry-input && npm run test:enquiry-transport && npm run test:mongodb-foundation && npm run test:mongodb-models && npm run test:request-safeguards && npm run test:admin-auth && npm run test:admin-shell && npm run test:admin-media && npm run test:admin-projects && npm run test:admin-story && npm run test:admin-preview && npm run test:admin-publish && npm run test:admin-featured && npm run test:admin-repo-migration"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.5",
    "better-auth": "^1.7.5",
    "cloudinary": "^2.10.0",
    "mongodb": "^6.21.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
